{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myllm",
  "version": "0.1.0",
  "identifier": "com.vitaliytv.myllm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myllm — omlx queue",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/vitaliytv/myllm/releases/latest/download/latest.json"]
    }
  }
}
